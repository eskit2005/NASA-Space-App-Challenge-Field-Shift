# ==============================================================================
# CropSeq .gitignore
# Project: Climate-Smart Crop Rotation Decision Support System
# Stack: Python (FastAPI / Pydantic / Uvicorn) + Frontend (React 18 / Vite / TypeScript)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Bytecode & Compiled Files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Packaging
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.tsbuildinfo
.eslintcache
.parcel-cache

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.cache
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.envrc
*.env
*.local
frontend/.env.local

# Explicitly preserve example environment configurations
!.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 6. Database Caches & Runtime Locks
# ------------------------------------------------------------------------------
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm
*.tmp

# Explicitly preserve reference datasets
!data/bangladesh/crop_recommender.db

# ------------------------------------------------------------------------------
# 7. IDEs, Editors & Local Tooling
# ------------------------------------------------------------------------------
.atlas/
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
tempCodeRunnerFile.py

# ------------------------------------------------------------------------------
# 8. Operating System Metadata (macOS & Windows)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# 9. General Logs & Scratch Files
# ------------------------------------------------------------------------------
*.log
test_*.cjs
test_*.js
scratch/
/test_*.png
/screenshot*.png

# Explicitly preserve frontend production assets
!frontend/src/assets/**
!frontend/public/**
