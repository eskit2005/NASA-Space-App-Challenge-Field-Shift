# S2 Environment Adapters
# Options for SOIL: soilgrids
# Options for WEATHER: openmeteo
ADAPTER_SOIL=soilgrids
ADAPTER_WEATHER=openmeteo
ADAPTER_CROPS=barc
# Options: llm (default, falls back to template on failure) or template
ADAPTER_EXPLAINER=llm

# S0 Intake Chat
# Options: rules (deterministic, no key) or llm (needs LLM_ENABLED=true)
ADAPTER_INTAKE=rules

# Optional S2 External API Keys (SoilGrids and Open-Meteo free tiers require NO key)
OPEN_METEO_API_KEY=

# S7 LLM Explainer (LiteLLM)
# Set LLM_ENABLED=false to force the template explainer.
LLM_ENABLED=true
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Cache & Storage
CACHE_DB=data/cache.sqlite

# S6 Placeholder Crop Parameters (mock values, replace before real use)
CROP_PARAMS=data/crops/crop_params.json

# S5: maximum candidate sequences sent to S6
MAX_SEQUENCES=60

# API
# Comma-separated browser origins allowed to call the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Empty = no auth (local only). Set a long random value in production;
# the frontend must send it as the X-API-Key header.
API_KEY=
