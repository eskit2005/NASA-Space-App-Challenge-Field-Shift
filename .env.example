# S2 Environment Adapters (Set to "soilgrids" and "openmeteo" to use live services)
# Options for SOIL: fake | soilgrids
# Options for WEATHER: fake | openmeteo
ADAPTER_SOIL=fake
ADAPTER_WEATHER=fake
ADAPTER_CROPS=fake
ADAPTER_EXPLAINER=fake

# Optional S2 External API Keys (SoilGrids and Open-Meteo free tiers require NO key)
OPEN_METEO_API_KEY=

# S7 LLM Explainer (LiteLLM)
LLM_ENABLED=false
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Cache & Storage
CACHE_DB=data/cache.sqlite
